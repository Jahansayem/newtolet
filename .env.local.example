# Geoapify API Key (Optional - Maps work without it using OpenStreetMap)
# Get your free API key from: https://www.geoapify.com/
# Free tier: 3,000 requests per day
# The app now uses OpenStreetMap by default (free, no API key needed)
# NEXT_PUBLIC_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
# VITE_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Payment Configuration
NEXT_PUBLIC_SITE_URL=https://www.newtolet.com
UDDOKTAPAY_BASE_URL=https://newtoletbd.paymently.io/api
UDDOKTAPAY_API_KEY=YOUR_UDDOKTAPAY_API_KEY

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Feature Flags
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_DUMMY_DATA=false
VITE_ENABLE_MAPS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ADMIN=true
VITE_ENABLE_DUMMY_DATA=false
