# Geoapify API Key (Optional - Maps work without it using OpenStreetMap)
# Get your free API key from: https://www.geoapify.com/
# Free tier: 3,000 requests per day
# The app now uses OpenStreetMap by default (free, no API key needed)
# NEXT_PUBLIC_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
# VITE_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google OAuth for Supabase Auth
# Configure these in Supabase Dashboard > Authentication > Providers > Google.
# For local Supabase CLI, use SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET in your shell.
# The frontend does not read these variables. Keep the secret server-side only.
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Payment Configuration
# Used for production password reset links. Keep this set to the public site
# URL so reset emails do not point to localhost during local testing.
NEXT_PUBLIC_SITE_URL=https://www.newtolet.com
# EPS (Easy Payment System Bangladesh). Use https://sandboxpgapi.eps.com.bd for testing
# and https://pgapi.eps.com.bd for live merchant credentials.
EPS_BASE_URL=https://sandboxpgapi.eps.com.bd
EPS_MERCHANT_ID=YOUR_EPS_MERCHANT_ID
EPS_STORE_ID=YOUR_EPS_STORE_ID
EPS_USERNAME=YOUR_EPS_USERNAME
EPS_PASSWORD=YOUR_EPS_PASSWORD
EPS_HASH_KEY=YOUR_EPS_HASH_KEY

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Feature Flags
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_DUMMY_DATA=false
VITE_ENABLE_MAPS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ADMIN=true
VITE_ENABLE_DUMMY_DATA=false
