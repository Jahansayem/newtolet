Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always unset Alt-Svc
  Header unset Alt-Svc

  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^listdetails/([^/]+)/?$ /listdetails/?id=$1 [L,QSA,NC]
  RewriteRule ^orderhome/([^/]+)/?$ /orderhome/?id=$1 [L,QSA,NC]
  RewriteRule ^book/([^/]+)/?$ /book/?id=$1 [L,QSA,NC]
  RewriteRule ^edit-property/([^/]+)/?$ /edit-property/?propertyId=$1 [L,QSA,NC]
</IfModule>
